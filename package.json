{
  "name": "@nourlabs/komipay-ts-sdk",
  "version": "1.0.0",
  "description": "Unofficial, standalone OOP TypeScript SDK for the KomiPay payment API (B2C, B2B, hosted checkout, transaction status)",
  "author": {
    "name": "Mahamadou Nouridine",
    "email": "mahamadounouridinem@gmail.com",
    "url": "https://nouridine.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahamadou-nouridine/komipay-ts-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mahamadou-nouridine/komipay-ts-sdk/issues"
  },
  "homepage": "https://github.com/mahamadou-nouridine/komipay-ts-sdk#readme",
  "keywords": [
    "komipay",
    "payment",
    "payment-gateway",
    "mobile-money",
    "api",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_EN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
